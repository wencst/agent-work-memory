from __future__ import annotations

from datetime import datetime, timedelta, timezone
from pathlib import Path

from fastapi.testclient import TestClient

from agent_work_memory.api import create_app
from agent_work_memory.config import Settings
from agent_work_memory.db import connect


def make_settings(tmp_path: Path, admin_key: str = "a" * 32, agent_key: str = "b" * 32) -> Settings:
    return Settings(
        admin_api_key=admin_key,
        agent_api_keys=(agent_key,),
        database_path=tmp_path / "test.db",
    )


def auth(token: str) -> dict[str, str]:
    return {"Authorization": f"Bearer {token}"}


def test_agent_can_submit_but_not_review(tmp_path: Path) -> None:
    settings = make_settings(tmp_path)
    client = TestClient(create_app(settings))
    payload = {
        "source": "opencode",
        "session_id": "s1",
        "event_type": "tool.after",
        "occurred_at": datetime.now(timezone.utc).isoformat(),
        "content": "Changed auth middleware",
        "metadata": {},
        "client_event_id": "event-1",
    }
    event = client.post("/v1/events", json=payload, headers=auth(settings.agent_api_keys[0]))
    assert event.status_code == 201
    assert client.get("/v1/memories", headers=auth(settings.agent_api_keys[0])).status_code == 403
    review = client.post("/v1/memories/does-not-exist/review", json={"action": "approve"}, headers=auth(settings.agent_api_keys[0]))
    assert review.status_code == 403


def test_admin_can_review_pending_memory(tmp_path: Path) -> None:
    settings = make_settings(tmp_path)
    client = TestClient(create_app(settings))
    event = client.post(
        "/v1/events",
        headers=auth(settings.agent_api_keys[0]),
        json={
            "source": "test",
            "session_id": "s1",
            "event_type": "note",
            "occurred_at": datetime.now(timezone.utc).isoformat(),
            "content": "We chose PostgreSQL for the event store.",
            "metadata": {},
            "client_event_id": "event-2",
        },
    ).json()
    conn = connect(settings.database_path)
    conn.execute(
        "INSERT INTO memories(id,event_id,kind,claim,evidence_quote,confidence,status,created_at) VALUES(?,?,?,?,?,?,?,?)",
        ("m1", event["id"], "decision", "We chose PostgreSQL for the event store.", "chose PostgreSQL", 0.9, "pending", datetime.now(timezone.utc).isoformat()),
    )
    conn.commit()
    conn.close()
    assert client.get("/v1/memories?status=pending", headers=auth(settings.admin_api_key)).status_code == 200
    approved = client.post("/v1/memories/m1/review", headers=auth(settings.admin_api_key), json={"action": "approve"})
    assert approved.status_code == 200
    search = client.get("/v1/search", headers=auth(settings.agent_api_keys[0]), params={"q": "PostgreSQL"})
    assert search.status_code == 200
    assert len(search.json()["items"]) == 1


def test_retention_clears_raw_content_only(tmp_path: Path) -> None:
    from agent_work_memory.cli import apply_retention

    settings = make_settings(tmp_path)
    conn = connect(settings.database_path)
    old = (datetime.now(timezone.utc) - timedelta(days=40)).isoformat()
    conn.execute(
        "INSERT INTO events(id,source,session_id,event_type,occurred_at,received_at,content) VALUES(?,?,?,?,?,?,?)",
        ("e1", "test", "s1", "note", old, old, "raw secret text"),
    )
    conn.commit()
    conn.close()
    assert apply_retention(settings) == 1
    conn = connect(settings.database_path)
    row = conn.execute("SELECT content,expired_at FROM events WHERE id='e1'").fetchone()
    conn.close()
    assert row["content"] is None
    assert row["expired_at"] is not None
